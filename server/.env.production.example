# LexFlow production environment template
#
# DO NOT commit this file with real values.
# Copy to the production host outside source control, fill in real secrets, and
# restrict permissions, for example: chmod 600 /opt/lexflow/server/.env.production
#
# In production, the server reads process environment variables. It does not
# load this file automatically. Configure your service manager, PM2 process, or
# hosting platform to provide these variables.

# --- Core ---
NODE_ENV=production
PORT=5000
DATABASE_PATH=/opt/lexflow/server/lawfirm.db
BASE_URL=https://lexflow.example.com
CORS_ORIGINS=https://lexflow.example.com

# High-entropy signing secret. Do not reuse development/test values.
JWT_SECRET=replace_with_high_entropy_jwt_secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=lexflow-production
JWT_AUDIENCE=lexflow-users

# Used only when the database has no users. Remove or rotate after first admin
# bootstrap. Must be at least 12 characters and not a common weak password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=LexFlowAdmin
SEED_ADMIN_PASSWORD=replace_with_temporary_first_admin_password

# --- Limits and rate limiting ---
JSON_BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Optional Helmet CSP overrides. Leave unset unless you have reviewed the JSON.
CSP_REPORT_ONLY=false
# CSP_DIRECTIVES={"defaultSrc":["'self'"],"scriptSrc":["'self'"],"styleSrc":["'self'","'unsafe-inline'"],"imgSrc":["'self'","data:","blob:"],"connectSrc":["'self'","https://lexflow.example.com"],"objectSrc":["'none'"],"baseUri":["'self'"],"frameAncestors":["'none'"]}

# --- Backup ---
BACKUP_DIR=/opt/lexflow/backups
BACKUP_LOG=/opt/lexflow/logs/backup.log
LEXFLOW_BACKUP_KEY=replace_with_64_hex_character_backup_encryption_key
LEXFLOW_BACKUP_RETENTION_COUNT=30

# --- OAuth ---
OAUTH_STAFF_ENABLED=true
OAUTH_CLIENT_ENABLED=false
OAUTH_STATE_SECRET=replace_with_high_entropy_oauth_state_secret
OAUTH_ALLOWED_DOMAINS=example.com
OAUTH_REQUIRE_VERIFIED_EMAIL=true

# Google OAuth - configure at https://console.cloud.google.com
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://lexflow.example.com/api/auth/oauth/google/callback

# Microsoft OAuth - configure at https://portal.azure.com
MICROSOFT_CLIENT_ID=replace_with_microsoft_client_id
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://lexflow.example.com/api/auth/oauth/microsoft/callback
