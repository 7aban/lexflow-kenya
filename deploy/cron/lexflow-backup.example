# Cron job for daily LexFlow encrypted backup
# Install: sudo cp lexflow-backup /etc/cron.d/lexflow-backup
# Ensure the backup user has read access to the server directory.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Run daily at 2:00 AM as the lexflow user
# Environment variables are loaded from the production env file.
0 2 * * * lexflow cd /opt/lexflow/server && set -a && . /opt/lexflow/server/.env.production && set +a && NODE_ENV=production node scripts/backup.js >> /var/log/lexflow/backup-cron.log 2>&1
