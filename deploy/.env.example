# LexFlow Docker local production environment
#
# Copy this file to deploy/.env and fill in real values.
# NEVER commit deploy/.env — it contains secrets.
#
# This file is for the Docker Compose runtime only.
# For bare-metal production, see server/.env.production.example.

# ── Core ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
DATABASE_PATH=/data/lawfirm.db
BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# ── JWT ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET
JWT_EXPIRES_IN=1h
JWT_ISSUER=lexflow-production
JWT_AUDIENCE=lexflow-users

# ── Seed admin (first boot only) ────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_TEMPORARY_ADMIN_PASSWORD

# ── Backup / encryption ─────────────────────────────────────────
BACKUP_DIR=/backups
BACKUP_LOG=/logs/backup.log
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEXFLOW_BACKUP_KEY=REPLACE_WITH_64_HEX_CHARACTER_BACKUP_KEY
LEXFLOW_BACKUP_RETENTION_COUNT=30

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ── Body limits ──────────────────────────────────────────────────
JSON_BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=10mb

# ── OAuth (optional — leave disabled unless configured) ──────────
OAUTH_STAFF_ENABLED=false
OAUTH_CLIENT_ENABLED=false
# OAUTH_STATE_SECRET=REPLACE_IF_OAUTH_ENABLED
# OAUTH_ALLOWED_DOMAINS=example.com
# OAUTH_REQUIRE_VERIFIED_EMAIL=true

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# Microsoft OAuth
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/oauth/microsoft/callback
