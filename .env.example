# LexFlow Kenya local development environment
#
# Copy to server/.env for local development only. Production services must set
# environment variables through the process manager, host, or service unit.
# See server/.env.production.example and docs/pilot-deployment-runbook.md.

# Local development mode. Use NODE_ENV=test only for automated tests.
NODE_ENV=development

# Express API port. The Vite dev proxy expects 5000 by default.
PORT=5000

# Local SQLite database path when starting the backend from server/.
DATABASE_PATH=lawfirm.db

# Local frontend/backend URL used for OAuth callbacks and app links.
BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development-only JWT settings. Use a high-entropy secret in shared or
# production environments.
JWT_SECRET=change-this-local-development-secret
JWT_EXPIRES_IN=8h
JWT_ISSUER=
JWT_AUDIENCE=

# Optional first-admin bootstrap values. These are used only when the database
# has no users. Change the password immediately after local first login.
SEED_ADMIN_EMAIL=admin@lexflow.co.ke
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=password123

# Local request limits and rate limits.
JSON_BODY_LIMIT=1mb
UPLOAD_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Local backup settings. Use a 64-hex-character key before relying on encrypted
# backups. Leave blank only for throwaway local development.
BACKUP_DIR=../backups
BACKUP_LOG=../logs/backup.log
LEXFLOW_BACKUP_KEY=
LEXFLOW_BACKUP_RETENTION_COUNT=7

# OAuth is disabled by default for local development.
OAUTH_STAFF_ENABLED=false
OAUTH_CLIENT_ENABLED=false
OAUTH_STATE_SECRET=change-this-local-oauth-state-secret
OAUTH_ALLOWED_DOMAINS=
OAUTH_REQUIRE_VERIFIED_EMAIL=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/oauth/microsoft/callback
